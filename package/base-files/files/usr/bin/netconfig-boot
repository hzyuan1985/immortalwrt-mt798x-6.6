                    log "下载的文件过小（${file_size}字节 < 1KB），删除并重试"
                    rm -f "$TEMP_SCRIPT"
                fi
            else
                log "下载的文件为空，删除并重试"
                rm -f "$TEMP_SCRIPT"
            fi
        else
            log "下载失败，等待 ${RETRY_DELAY} 秒后重试"
        fi
        
        # 如果不是最后一次尝试，则等待
        if [ $retry -lt $MAX_RETRIES_PER_URL ]; then
            sleep $RETRY_DELAY
        fi
    done

    # 如果第一个URL失败，尝试第二个URL
    if [ $SUCCESS -eq 0 ]; then
        log "URL1下载尝试失败，尝试URL2"
        
        # 在尝试URL2之前删除可能存在的netconfig文件
        if [ -f "/root/netconfig" ]; then
            log "删除可能损坏的netconfig文件"
            rm -f "/root/netconfig"
        fi
        
        for retry in $(seq 1 $MAX_RETRIES_PER_URL); do
            log "尝试第 $retry/$MAX_RETRIES_PER_URL 次从URL2下载"
            
            # 使用wget下载脚本，增加超时参数
            if wget -q -T 10 -O "$TEMP_SCRIPT" "$URL2"; then
                # 检查文件是否为空且不小于1KB
                if [ -s "$TEMP_SCRIPT" ]; then
                    if command_exists stat; then
                        file_size=$(stat -c%s "$TEMP_SCRIPT" 2>/dev/null || echo "0")
                    else
                        file_size=$(wc -c < "$TEMP_SCRIPT" 2>/dev/null || echo "0")
                    fi
                    if [ "$file_size" -ge 1024 ]; then
                        log "从 $URL2 下载成功，文件大小: ${file_size}字节"
                        SUCCESS=1
                        break
                    else
                        log "下载的文件过小（${file_size}字节 < 1KB），删除并重试"
                        rm -f "$TEMP_SCRIPT"
                    fi
                else
                    log "下载的文件为空，删除并重试"
                    rm -f "$TEMP_SCRIPT"
                fi
            else
                log "下载失败，等待 ${RETRY_DELAY} 秒后重试"
            fi
            
            # 如果不是最后一次尝试，则等待
            if [ $retry -lt $MAX_RETRIES_PER_URL ]; then
                sleep $RETRY_DELAY
            fi
        done
    fi

    # 检查下载是否成功
    if [ $SUCCESS -eq 0 ]; then
        log "错误: 所有下载URL尝试均失败"
        exit 0  # 退出但不阻止系统继续启动
    fi
fi

