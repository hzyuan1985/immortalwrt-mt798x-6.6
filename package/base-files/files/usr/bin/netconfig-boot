#!/bin/sh

# 日志文件位置
LOG_FILE="/root/netconfig-boot.log"

# 记录日志函数
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

# 检查命令是否存在
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

log "开始执行netconfig-boot脚本"

# 检查本地netconfig文件是否存在
if [ -f "/root/netconfig" ]; then
    log "发现本地netconfig文件，跳过下载"
else
    log "未找到本地netconfig文件，开始下载流程"
    
    # 检查wget是否存在
    if ! command_exists wget; then
        log "错误: 未找到wget命令，无法下载文件"
        exit 0
    fi

    # 下载URL配置
    DOWNLOAD_URL="http://192.168.100.253/360T7/netconfig"
    TEMP_SCRIPT="/root/netconfig"

    # 尝试下载网络配置脚本
    MAX_RETRIES=10
    RETRY_DELAY=6
    SUCCESS=0

    for i in $(seq 1 $MAX_RETRIES); do
        # 检查目标服务器是否可达
        if ping -c 1 -W 2 192.168.100.253 >/dev/null 2>&1; then
            log "尝试第 $i/$MAX_RETRIES 次下载网络配置脚本"
            
            # 使用wget下载脚本，增加超时参数
            if wget -q -T 5 -O "$TEMP_SCRIPT" "$DOWNLOAD_URL"; then
                # 检查文件是否为空
                if [ -s "$TEMP_SCRIPT" ]; then
                    log "下载成功"
                    SUCCESS=1
                    break
                else
                    log "下载的文件为空，等待 ${RETRY_DELAY} 秒后重试"
                    rm -f "$TEMP_SCRIPT"
                fi
            else
                log "下载失败，等待 ${RETRY_DELAY} 秒后重试"
            fi
        else
            log "服务器不可达，等待 ${RETRY_DELAY} 秒后重试"
        fi
        
        # 如果不是最后一次尝试，则等待
        if [ $i -lt $MAX_RETRIES ]; then
            sleep $RETRY_DELAY
        fi
    done

    # 检查下载是否成功
    if [ $SUCCESS -eq 0 ]; then
        log "错误: 经过 $MAX_RETRIES 次尝试后仍无法下载网络配置脚本"
        exit 0  # 退出但不阻止系统继续启动
    fi
fi

# 确保文件具有执行权限
if [ -f "/root/netconfig" ]; then
    if chmod +x "/root/netconfig"; then
        log "已成功给予netconfig脚本执行权限"
    else
        log "错误: 无法给予netconfig脚本执行权限"
        exit 0
    fi
else
    log "错误: netconfig文件不存在"
    exit 0
fi

# 执行netconfig脚本
log "开始执行netconfig脚本"
sh "/root/netconfig" >> "$LOG_FILE" 2>&1
EXEC_EXIT_CODE=$?
log "netconfig脚本执行完成，退出码: $EXEC_EXIT_CODE"

log "netconfig-boot脚本执行完成"
exit 0
