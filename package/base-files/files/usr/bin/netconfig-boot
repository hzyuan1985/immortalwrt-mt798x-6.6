if [ -f "/root/netconfig" ]; then
    if chmod +x "/root/netconfig"; then
        log "已成功给予netconfig脚本执行权限"
    else
        log "错误: 无法给予netconfig脚本执行权限"
        exit 0
    fi
else
    log "错误: netconfig文件不存在"
    exit 0
fi

