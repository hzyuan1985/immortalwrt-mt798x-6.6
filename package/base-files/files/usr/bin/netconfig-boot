#!/bin/sh

# 日志文件位置
LOG_FILE="/root/netconfig-boot.log"

# 记录日志函数
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

# 检查命令是否存在
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# 检查网络连接函数
check_network() {
    log "开始检查网络连接"
    
    # 首先尝试ping 8.8.8.8
    if ping -c 2 -W 3 8.8.8.8 >/dev/null 2>&1; then
        log "网络连接正常 (ping 8.8.8.8 成功)"
        return 0
    fi
    
    # 如果8.8.8.8不通，尝试ping国内DNS 202.96.128.86
    log "8.8.8.8 连接失败，尝试 202.96.128.86"
    if ping -c 2 -W 3 202.96.128.86 >/dev/null 2>&1; then
        log "网络连接正常 (ping 202.96.128.86 成功)"
        return 0
    fi
    
    log "网络连接失败"
    return 1
}

# 修改网络配置为PPPoE
setup_pppoe_network() {
    log "尝试修改网络配置为PPPoE"
    
    # 检查PPPoE配置文件是否存在
    if [ ! -f "/usr/bin/network-pppoe" ]; then
        log "错误: /usr/bin/network-pppoe 文件不存在"
        return 1
    fi
    
    # 备份当前网络配置（如果还没有备份的话）
    if [ ! -f "/etc/config/network.bak" ]; then
        cp -f "/etc/config/network" "/etc/config/network.bak"
        log "已备份原网络配置到 /etc/config/network.bak"
    fi
    
    # 使用PPPoE配置文件替换当前网络配置
    if cp -f "/usr/bin/network-pppoe" "/etc/config/network"; then
        log "已替换网络配置为PPPoE"
        
        # 注意：这里不删除network-pppoe文件，等待成功联网后再删除
        log "等待网络连接成功后再删除PPPoe配置文件"
        
        # 重启网络
        log "重启网络服务"
        /etc/init.d/network restart >/dev/null 2>&1
        sleep 5  # 等待网络服务重启完成
        
        return 0
    else
        log "错误: 无法替换网络配置"
        return 1
    fi
}

# 检查PPPoE拨号后的网络连接（增加重试次数）
check_pppoe_network() {
    local max_retries=8
    local retry_interval=5
    
    log "开始检查PPPoE拨号网络连接，最多尝试 ${max_retries} 次，每次间隔 ${retry_interval} 秒"
    
    for attempt in $(seq 1 $max_retries); do
        log "第 ${attempt}/${max_retries} 次检查网络连接"
        
        if check_network; then
            log "第 ${attempt} 次检查：网络连接成功"
            return 0
        else
            if [ $attempt -lt $max_retries ]; then
                log "第 ${attempt} 次检查：网络连接失败，等待 ${retry_interval} 秒后重试"
                sleep $retry_interval
            else
                log "第 ${attempt} 次检查：网络连接失败，已达到最大重试次数"
            fi
        fi
    done
    
    return 1
}

# 清理PPPoE配置文件（仅在成功联网后调用）
cleanup_pppoe_files() {
    log "清理PPPoE配置文件"
    
    # 删除PPPoE配置文件
    if [ -f "/usr/bin/network-pppoe" ]; then
        rm -f "/usr/bin/network-pppoe"
        log "已删除 /usr/bin/network-pppoe"
    fi
    
    # 删除网络配置备份文件
    if [ -f "/etc/config/network.bak" ]; then
        rm -f "/etc/config/network.bak"
        log "已删除 /etc/config/network.bak"
    fi
}

# 恢复原网络配置
restore_original_network() {
    log "恢复原网络配置"
    
    # 检查备份文件是否存在
    if [ -f "/etc/config/network.bak" ]; then
        # 恢复备份的网络配置
        if cp -f "/etc/config/network.bak" "/etc/config/network"; then
            log "已恢复原网络配置"
            
            # 重启网络
            log "重启网络服务"
            /etc/init.d/network restart >/dev/null 2>&1
            sleep 5  # 等待网络服务重启完成
            
            return 0
        else
            log "错误: 无法恢复网络配置"
            return 1
        fi
    else
        log "警告: 找不到网络配置备份文件"
        return 1
    fi
}

log "开始执行netconfig-boot脚本"

# ========== 新增的网络连接检查逻辑开始 ==========
# 第一次检查网络连接（初始DHCP状态）
if ! check_network; then
    log "网络连接失败，尝试切换到PPPoE拨号"
    
    # 尝试修改为PPPoE配置
    if setup_pppoe_network; then
        log "等待PPPoE拨号连接..."
        
        # 使用增强版网络检查（8次重试，每次5秒）
        if check_pppoe_network; then
            log "PPPoE拨号成功，网络已连接"
            
            # 成功联网后清理PPPoE配置文件
            cleanup_pppoe_files
        else
            log "PPPoE拨号后网络仍然不可用，恢复原配置"
            
            # 恢复原网络配置
            if restore_original_network; then
                log "网络配置已恢复，但网络连接失败"
                echo "网络连接失败，请检查网络设置"
            else
                log "恢复网络配置失败"
                echo "网络连接失败且无法恢复配置"
            fi
        fi
    else
        log "切换到PPPoE失败，保持原配置"
    fi
else
    log "网络连接正常，继续执行脚本"
fi
# ========== 新增的网络连接检查逻辑结束 ==========

# 检查本地netconfig文件是否存在且有效（不小于1kb）
if [ -f "/root/netconfig" ]; then
    # 获取文件大小（字节）
    if command_exists stat; then
        file_size=$(stat -c%s "/root/netconfig" 2>/dev/null || echo "0")
    else
        file_size=$(wc -c < "/root/netconfig" 2>/dev/null || echo "0")
    fi
    
    if [ "$file_size" -ge 1024 ]; then
        log "发现有效的本地netconfig文件（大小: ${file_size}字节），跳过下载"
    else
        log "本地netconfig文件过小（${file_size}字节 < 1KB），删除并重新下载"
        rm -f "/root/netconfig"
    fi
else
    log "未找到本地netconfig文件"
fi

# 如果netconfig文件不存在，则进行下载
if [ ! -f "/root/netconfig" ]; then
    log "开始下载netconfig文件"
    
    # 检查wget是否存在
    if ! command_exists wget; then
        log "错误: 未找到wget命令，无法下载文件"
        exit 0
    fi

    # 定义下载URL列表（按优先级排序）
    URL1="http://192.168.100.253/360T7/netconfig"  # 局域网URL
    URL2="https://gitee.com/hziqian/netconfig/raw/master/netconfig"  # Gitee备用URL
    
    # 下载参数
    TEMP_SCRIPT="/root/netconfig"
    MAX_RETRIES_PER_URL=3
    RETRY_DELAY=5
    SUCCESS=0

    # 尝试第一个URL
    log "尝试从URL1下载: $URL1"
    domain1=$(echo "$URL1" | sed 's|http://||' | cut -d'/' -f1)
    
    for retry in $(seq 1 $MAX_RETRIES_PER_URL); do
        # 对HTTP URL进行ping检测
        if echo "$URL1" | grep -q "^http://"; then
            if ! ping -c 1 -W 2 "$domain1" >/dev/null 2>&1; then
                log "服务器 $domain1 不可达，等待 ${RETRY_DELAY} 秒后重试"
                sleep $RETRY_DELAY
                continue
            fi
        fi
        
        log "尝试第 $retry/$MAX_RETRIES_PER_URL 次下载"
        
        # 使用wget下载脚本，增加超时参数
        if wget -q -T 10 -O "$TEMP_SCRIPT" "$URL1"; then
            # 检查文件是否为空且不小于1KB
            if [ -s "$TEMP_SCRIPT" ]; then
                if command_exists stat; then
                    file_size=$(stat -c%s "$TEMP_SCRIPT" 2>/dev/null || echo "0")
                else
                    file_size=$(wc -c < "$TEMP_SCRIPT" 2>/dev/null || echo "0")
                fi
                if [ "$file_size" -ge 1024 ]; then
                    log "从 $URL1 下载成功，文件大小: ${file_size}字节"
                    SUCCESS=1
                    break
                else
                    log "下载的文件过小（${file_size}字节 < 1KB），删除并重试"
                    rm -f "$TEMP_SCRIPT"
                fi
            else
                log "下载的文件为空，删除并重试"
                rm -f "$TEMP_SCRIPT"
            fi
        else
            log "下载失败，等待 ${RETRY_DELAY} 秒后重试"
        fi
        
        # 如果不是最后一次尝试，则等待
        if [ $retry -lt $MAX_RETRIES_PER_URL ]; then
            sleep $RETRY_DELAY
        fi
    done

    # 如果第一个URL失败，尝试第二个URL
    if [ $SUCCESS -eq 0 ]; then
        log "URL1下载尝试失败，尝试URL2"
        
        # 在尝试URL2之前删除可能存在的netconfig文件
        if [ -f "/root/netconfig" ]; then
            log "删除可能损坏的netconfig文件"
            rm -f "/root/netconfig"
        fi
        
        for retry in $(seq 1 $MAX_RETRIES_PER_URL); do
            log "尝试第 $retry/$MAX_RETRIES_PER_URL 次从URL2下载"
            
            # 使用wget下载脚本，增加超时参数
            if wget -q -T 10 -O "$TEMP_SCRIPT" "$URL2"; then
                # 检查文件是否为空且不小于1KB
                if [ -s "$TEMP_SCRIPT" ]; then
                    if command_exists stat; then
                        file_size=$(stat -c%s "$TEMP_SCRIPT" 2>/dev/null || echo "0")
                    else
                        file_size=$(wc -c < "$TEMP_SCRIPT" 2>/dev/null || echo "0")
                    fi
                    if [ "$file_size" -ge 1024 ]; then
                        log "从 $URL2 下载成功，文件大小: ${file_size}字节"
                        SUCCESS=1
                        break
                    else
                        log "下载的文件过小（${file_size}字节 < 1KB），删除并重试"
                        rm -f "$TEMP_SCRIPT"
                    fi
                else
                    log "下载的文件为空，删除并重试"
                    rm -f "$TEMP_SCRIPT"
                fi
            else
                log "下载失败，等待 ${RETRY_DELAY} 秒后重试"
            fi
            
            # 如果不是最后一次尝试，则等待
            if [ $retry -lt $MAX_RETRIES_PER_URL ]; then
                sleep $RETRY_DELAY
            fi
        done
    fi

    # 检查下载是否成功
    if [ $SUCCESS -eq 0 ]; then
        log "错误: 所有下载URL尝试均失败"
        exit 0  # 退出但不阻止系统继续启动
    fi
fi

# 确保文件具有执行权限
if [ -f "/root/netconfig" ]; then
    if chmod +x "/root/netconfig"; then
        log "已成功给予netconfig脚本执行权限"
    else
        log "错误: 无法给予netconfig脚本执行权限"
        exit 0
    fi
else
    log "错误: netconfig文件不存在"
    exit 0
fi

# 执行netconfig脚本
log "开始执行netconfig脚本"
sh "/root/netconfig" >> "$LOG_FILE" 2>&1
EXEC_EXIT_CODE=$?
log "netconfig脚本执行完成，退出码: $EXEC_EXIT_CODE"

log "netconfig-boot脚本执行完成"
exit 0